# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Allow these origins to call the API (comma-separated).
# For local dev the frontend runs on http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Your Gmail address (optional — used to email contact submissions to yourself).
# Leave blank to skip email sending.
CONTACT_EMAIL=bettynure1@gmail.com

# App password generated in Google Account → Security → App passwords.
# Required only when CONTACT_EMAIL is set.
SMTP_PASSWORD=

# SQLite database file path (relative to the backend/ directory).
DATABASE_URL=sqlite:///./portfolio.db

# A random secret used internally (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production
